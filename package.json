{
  "name": "rest-express",
  "version": "2.1.8",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "node scripts/ensure-rollup-native.mjs && vite build && node scripts/build-server.mjs && node scripts/verify-runtime-bundle.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:real-db": "npm run test:real-db:retention && npm run test:real-db:rehearsal && npm run test:real-db:monthly-salary-run",
    "test:real-db:retention": "vitest run --config vitest.real-db.config.ts server/storage.retention.real-db.test.ts",
    "test:real-db:rehearsal": "vitest run --config vitest.real-db.config.ts server/rehearsal.real-db.test.ts",
    "test:real-db:monthly-salary-run": "vitest run --config vitest.real-db.config.ts server/repositories/monthlySalaryRunRepository.real-db.test.ts",
    "test:mobile-ui": "playwright test --config=playwright.config.ts client/__tests__/mobile-ui.spec.ts",
    "restore:check": "tsx server/scripts/restore-check.ts",
    "restore:check:required": "tsx server/scripts/restore-check.ts --require-backup",
    "restore:rehearse": "tsx server/scripts/restore-rehearsal.ts",
    "aes:inspect": "node scripts/inspect-employees.mjs",
    "aes:report": "node scripts/migrate-to-aes.mjs",
    "aes:snapshot": "node scripts/migrate-to-aes.mjs --snapshot",
    "aes:rehearse": "node scripts/migrate-to-aes.mjs --rehearse",
    "aes:status": "node scripts/aes-migration-status.mjs",
    "aes:ready": "node scripts/aes-migration-status.mjs --require-ready",
    "aes:migrate": "node scripts/migrate-to-aes.mjs --execute",
    "aes:rollback": "node scripts/migrate-to-aes.mjs --rollback",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "super-pin:hash": "node scripts/hash-super-admin-pin.mjs",
    "runtime:update:audit": "node scripts/runtime-update-audit.mjs",
    "version:preview": "node scripts/version-auto.mjs",
    "version:auto": "node scripts/version-auto.mjs --apply",
    "smoke:live": "node scripts/live-smoke.mjs",
    "security:supabase:check": "node scripts/harden-supabase-public-schema.mjs --check",
    "security:supabase:harden": "node scripts/harden-supabase-public-schema.mjs --apply",
    "db:employee-recycle-bin:check": "node scripts/apply-employee-recycle-bin-schema.mjs --check",
    "db:employee-recycle-bin:apply": "node scripts/apply-employee-recycle-bin-schema.mjs --apply",
    "verify:ops": "npm run verify:core && npm run restore:check",
    "verify:baseline": "npm run check && npm run build",
    "verify:ci": "npm run check && npm test && npm run build",
    "verify:release": "npm run verify:ci && npm run test:smoke && npm run restore:check",
    "verify:core": "npm test && npm run verify:baseline",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.1.0",
    "@line/liff": "^2.29.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toast": "^1.2.18",
    "@tanstack/react-query": "^5.101.2",
    "@types/pg": "^8.15.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.16",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "postgres": "^3.4.7",
    "puppeteer-core": "^25.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "24.12.4",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "drizzle-kit": "^0.31.7",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.16",
    "rollup": "^4.62.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.0",
    "@rollup/rollup-win32-x64-msvc": "^4.60.0",
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "axios": "^1.16.1",
    "lodash": "4.18.1",
    "yaml": "^2.8.3",
    "esbuild": "^0.28.1"
  }
}
