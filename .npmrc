# Fallback for platforms that accidentally run production-style installs during build.
include=dev

# Cloud builders can occasionally hit short npm registry resets. Keep installs
# deterministic, but give transient network failures a few chances to recover.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=120000
audit=false
fund=false
